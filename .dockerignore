# Docker build context = repo root (backend/Dockerfile). Allow-list: only what the image build needs.
# Secrets (.env.local, backend/.env, any .env*) and local artifacts must never enter the context.
*
!package.json
!package-lock.json
!index.html
!vite.config.js
!src/
!scripts/
!backend/
# build-pages.mjs copies these into dist/assets. The allow-list must name each parent
# directory or Docker will not re-include files under an excluded directory.
!public/
!public/assets/
!public/assets/logo-sprite.png
!public/assets/game-thumb-daywar.png
**/.env*
**/node_modules
**/.DS_Store
dist
backend/target
backend/src/test
backend/.env*
backend/_module-state.yml
backend/DEPLOY.md
