# Copy to .env.local and adjust. Nothing here is secret; never put tokens in VITE_* (they end up in the bundle).
# API base path (same origin; the backend has no CORS). Default /api/csg/v1.
VITE_API_BASE_URL=/api/csg/v1
# Dev only: true = MSW mocks, false = proxy /api to API_PROXY_TARGET.
VITE_API_MOCK=true
# Where `vite` (mock off) and `vite preview` proxy /api.
API_PROXY_TARGET=http://localhost:8080
# Google Identity client id. The 登入 button only appears when this has a value (empty = login entries hidden).
# Put the real value in .env.local (front end). The backend reads the SAME id from the GOOGLE_CLIENT_ID env var
# (backend/docker-compose.yml: GOOGLE_CLIENT_ID=... docker compose up -d). Both values must be identical.
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID -> type "Web application";
# add http://localhost:5174 under "Authorized JavaScript origins" (plus your deployed origin).
VITE_GOOGLE_CLIENT_ID=
